---
import BaseLayout from "../layouts/BaseLayout.astro";
import Prompt from "../components/Prompt.astro";
import withBase from "../lib/withBase";
import { socials, EMAIL } from "../lib/links";

const fetch = [
  ["Name", "Imam Hossain Roni"],
  ["Role", "Full-Stack Software Engineer"],
  ["Location", "Frankfurt am Main, Germany"],
  ["Uptime", "6+ years in production"],
  ["Backend", "Python, Django, FastAPI, C#, ASP.NET Core"],
  ["AI", "LLMs, RAG, MCP, vector search"],
  ["Cloud", "AWS, Azure, Docker, Kubernetes, Terraform"],
  ["Studying", "M.Sc. Automotive Software Eng. @ TU Chemnitz"],
];

const news = [
  { date: "2026-04", text: "Wrapped up my work-study at Flowvy, building an AI knowledge platform with RAG, vector search and MCP." },
  { date: "2024-10", text: "Started my M.Sc. in Automotive Software Engineering at TU Chemnitz." },
  { date: "2023-07", text: "Joined TESVOLT AG (remote, Berlin) to work on battery storage monitoring and energy trading." },
];

const focusAreas = [
  { title: "AI & LLM Systems", desc: "RAG pipelines, embeddings, vector search and MCP integrations that bring LLMs into real business workflows." },
  { title: "Full-Stack Development", desc: "APIs with Django, FastAPI and ASP.NET Core, and frontends in React, Vue and Angular." },
  { title: "DevOps & Cloud", desc: "AWS and Azure with Docker, Kubernetes, Terraform and CI/CD, monitored with Grafana and Prometheus." },
  { title: "Energy & Battery Storage", desc: "BESS monitoring, simulation and real-time energy trading software." },
];

const selectedWork = [
  { period: "2025–26", name: "ai-knowledge-platform", title: "AI-Powered Business Knowledge Platform", company: "Flowvy" },
  { period: "2023–25", name: "bess-monitoring-trading", title: "Battery Storage Monitoring & Energy Trading", company: "TESVOLT AG" },
  { period: "2021–23", name: "quantibly", title: "Quantibly: NGO Data Management SaaS", company: "iQuantile LLC" },
];

const coreStack = ["python", "django", "fastapi", "csharp", "aspnet-core", "typescript", "postgresql", "redis", "docker", "kubernetes", "terraform", "aws", "azure"];
---

<BaseLayout sideBarActiveItemID="home">
  <Prompt cmd="neofetch">
    <div class="neofetch mt-2">
      <img src={withBase("/profile.webp")} alt="Photo of Imam Hossain Roni" width="459" height="459" />
      <div>
        <p class="c-green font-bold">Imam Hossain Roni</p>
        <p class="dim">-----------------</p>
        {
          fetch.map(([k, v]) => (
            <p>
              <span class="c-yellow font-bold">{k}</span>: {v}
            </p>
          ))
        }
        <div class="swatches" aria-hidden="true">
          {["#2e3436", "#ff6b6b", "#5fd068", "#e8c46a", "#6aa6ff", "#d18cf0", "#56c2d6", "#d7d7d7"].map((c) => <span style={`background:${c}`} />)}
        </div>
      </div>
    </div>
  </Prompt>

  <Prompt cmd="cat about.txt">
    <p>
      Hi, I'm Imam. I build Python, Django, FastAPI, Celery, Redis and RabbitMQ backends with LLM-powered features,
      modern frontends, and the cloud infrastructure behind them on AWS and Azure.
    </p>
    <p>
      My work spans AI, energy trading, battery storage and enterprise software, turning complex business problems into
      reliable, scalable solutions.
    </p>
  </Prompt>

  <Prompt cmd="tail -3 news.log">
    {
      news.map((n) => (
        <p class="!mt-0">
          <span class="c-green">[{n.date}]</span> {n.text}
        </p>
      ))
    }
  </Prompt>

  <Prompt cmd="cat focus.md">
    <ul class="md-list">
      {
        focusAreas.map((a) => (
          <li>
            <span class="c-yellow font-bold">{a.title}</span>: {a.desc}
          </li>
        ))
      }
    </ul>
  </Prompt>

  <Prompt cmd="ls -l ~/projects">
    <p class="dim">total {selectedWork.length}</p>
    {
      selectedWork.map((w) => (
        <div class="ls-row">
          <span class="ls-perm dim">drwxr-xr-x</span>
          <span class="dim">{w.period}</span>
          <span>
            <a href={withBase("/projects")} class="!no-underline hover:!underline">
              <span class="c-blue font-bold">{w.name}/</span>
            </a>{" "}
            <span class="dim">
              # {w.title}, {w.company}
            </span>
          </span>
        </div>
      ))
    }
    <p class="dim mt-2">
      → <a href={withBase("/projects")}>cd ~/projects</a> to see everything
    </p>
  </Prompt>

  <Prompt cmd="echo $STACK">
    <p class="c-green">{coreStack.join(" ")}</p>
  </Prompt>

  <Prompt cmd="cat contact.txt">
    <div class="grid grid-cols-[10ch_1fr] gap-x-2">
      <span class="c-yellow">email</span><a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      {
        socials.map((s) => (
          <>
            <span class="c-yellow">{s.label.split(" ")[0].toLowerCase()}</span>
            <a href={s.href} target="_blank" rel="noopener" class="break-all">
              {s.href.replace(/^https:\/\/(www\.)?/, "")}
            </a>
          </>
        ))
      }
    </div>
  </Prompt>
</BaseLayout>
