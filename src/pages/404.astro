---
import BaseLayout from "../layouts/BaseLayout.astro";
import Prompt from "../components/Prompt.astro";
import withBase from "../lib/withBase";
---

<BaseLayout title="404: Not Found">
  <Prompt cmd="cd /that-page">
    <p><span class="c-red">cd: no such file or directory:</span> <span data-path>/that-page</span></p>
  </Prompt>
  <Prompt cmd="cd ~" failed>
    <p class="dim">That page doesn't exist. Head back <a href={withBase("/")}>home</a>, or type <span class="c-green">help</span> below.</p>
  </Prompt>
</BaseLayout>

<script>
  // Show the path the visitor actually asked for.
  const path = decodeURIComponent(location.pathname);
  document.querySelectorAll("[data-path]").forEach((el) => (el.textContent = path));
  const firstCmd = document.querySelector(".prompt .p-cmd");
  if (firstCmd) firstCmd.textContent = `cd ${path}`;
</script>
