---
import BaseLayout from "../layouts/BaseLayout.astro";
import withBase from "../lib/withBase";
---

<BaseLayout title="404: Not Found" wide>
  <section class="wrap pt-16 md:pt-24 min-h-[60vh] flex flex-col justify-center">
    <p class="eyebrow mb-6">Error 404</p>
    <h1 class="display text-[clamp(4rem,16vw,15rem)]">
      Lost at <em>sea.</em>
    </h1>
    <p class="mt-8 max-w-md text-lg text-muted">The page you're looking for couldn't be found. It may have moved, or never existed.</p>
    <div class="mt-10">
      <a class="btn-ink" href={withBase("/")}>← Back home</a>
    </div>
  </section>
</BaseLayout>
