---
import BaseLayout from "../layouts/BaseLayout.astro";
import Prompt from "../components/Prompt.astro";

const groups = [
  {
    name: "AI & Knowledge Systems",
    projects: [
      {
        title: "AI-Powered Business Knowledge Platform",
        org: "Flowvy",
        period: "2025–2026",
        desc: "A platform that turns company knowledge and documents into searchable, contextual information, so teams spend less time on manual research and make decisions faster.",
        tags: ["Django", "RAG", "Embeddings", "Vector Search", "Data Pipelines"],
      },
      {
        title: "MCP Integration Layer for Business Workflows",
        org: "Flowvy",
        period: "2025–2026",
        desc: "Connected LLMs to project management, calendar, email and ERP systems through an MCP-based integration layer, so the AI can retrieve business context and carry out context-aware actions.",
        tags: ["MCP", "LLMs", "Integrations"],
      },
    ],
  },
  {
    name: "Energy & Battery Storage",
    projects: [
      {
        title: "BESS Monitoring Software",
        org: "TESVOLT AG",
        period: "2023–2025",
        desc: "Monitoring for battery energy storage systems that shows SOC, SOH, cell and module voltages, and thermal performance to support system health checks and operational decisions.",
        tags: ["Python", "Monitoring", "APIs"],
      },
      {
        title: "BESS Simulation & Recommendation System",
        org: "TESVOLT AG",
        period: "2023–2025",
        desc: "A Python-based system that simulates battery behavior under customer demand and operating scenarios, and recommends charging/discharging strategies and BESS configurations.",
        tags: ["Python", "Simulation"],
      },
      {
        title: "Real-Time Energy Trading Dashboard",
        org: "TESVOLT AG",
        period: "2023–2025",
        desc: "Combines real-time battery and market data to support energy trading decisions, with a dashboard that refreshes every 5 seconds.",
        tags: ["Real-time Data", "Energy Markets"],
      },
    ],
  },
  {
    name: "SaaS & Enterprise Software",
    projects: [
      {
        title: "Quantibly: NGO Data Management SaaS",
        org: "iQuantile LLC",
        period: "2021–2023",
        desc: "Backend services and APIs that centralize operational data for NGOs, plus work on the frontend, deployment and application monitoring.",
        tags: ["SaaS", "Backend", "Monitoring"],
      },
      {
        title: "Location-Based Survey & Data Collection System",
        org: "Qtec Solution Ltd.",
        period: "2020–2021",
        desc: "Field data collection with real-time monitoring and enhanced logging, deployed and maintained on DigitalOcean.",
        tags: ["Geolocation", "Logging", "DigitalOcean"],
      },
      {
        title: "ERP & VAT Management Software",
        org: "Divine IT Ltd.",
        period: "2019–2020",
        desc: "ERP and VAT software used by 1M+ end users. Built modules for fleet, support tickets, warranty, inventory and product management, and adapted the platform to run on multiple database engines.",
        tags: ["ERP", "Multi-database", "1M+ users"],
      },
    ],
  },
];


// Directory-style names for each group, e.g. "AI & Knowledge Systems" -> "ai-knowledge-systems".
const slug = (s: string) => s.toLowerCase().replace(/&/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
---

<BaseLayout title="Projects - Imam Hossain Roni" sideBarActiveItemID="projects">
  <Prompt dir="~/projects" cmd="cat README.md">
    <p>
      Systems I've built since 2019: AI that understands a company's own knowledge, software for battery energy storage,
      and the SaaS and ERP platforms where it all started.
    </p>
  </Prompt>

  <Prompt dir="~/projects" cmd="ls">
    <p>
      {
        groups.map((g) => (
          <>
            <span class="c-blue font-bold">{slug(g.name)}/</span>{"  "}
          </>
        ))
      }
    </p>
  </Prompt>

  {
    groups.map((group) => (
      <Prompt dir="~/projects" cmd={`cat ${slug(group.name)}/*.md`}>
        <h2 class="md-h1 !mt-1">{group.name}</h2>
        <div class="grid gap-5">
          {group.projects.map((p) => (
            <article>
              <h3 class="md-h2 !my-0">{p.title}</h3>
              <p class="dim">
                {p.org} · {p.period}
              </p>
              <p class="mt-1">{p.desc}</p>
              <p class="mt-1">
                <span class="c-yellow">tags:</span> <span class="c-green">{p.tags.join(", ")}</span>
              </p>
            </article>
          ))}
        </div>
      </Prompt>
    ))
  }
</BaseLayout>
