---
const { label, index } = Astro.props;
---

<section class="grid gap-6 md:grid-cols-12 md:gap-8 border-t border-line pt-8 md:pt-10 mt-14 md:mt-20 print:mt-6 print:pt-4 break-inside-avoid-page">
  <div class="md:col-span-3">
    <div class="md:sticky md:top-28 flex md:block items-baseline gap-4">
      <p class="eyebrow">{index}</p>
      <h2 class="display text-4xl md:text-5xl md:mt-3">{label}</h2>
    </div>
  </div>
  <div class="md:col-span-9 md:col-start-4" data-reveal>
    <slot />
  </div>
</section>
