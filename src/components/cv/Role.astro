---
const { role, org, period, place } = Astro.props;
---

<article class="grid gap-3 md:grid-cols-[1fr_auto] md:gap-x-10 py-7 first:pt-0 border-b border-line last:border-b-0 break-inside-avoid">
  <div>
    <h3 class="text-xl md:text-2xl font-medium tracking-tight">
      {role} <span class="text-muted font-light">at</span> <span class="display italic text-[1.15em]">{org}</span>
    </h3>
  </div>
  <p class="eyebrow md:text-right md:pt-2 md:whitespace-nowrap">
    {period}{place && <><span class="md:hidden"> · </span><br class="hidden md:block" />{place}</>}
  </p>
  <div class="md:col-span-2 mt-1 text-muted leading-relaxed [&_ul]:grid [&_ul]:gap-2.5 [&_li]:relative [&_li]:pl-5 [&_li]:before:absolute [&_li]:before:left-0 [&_li]:before:top-[0.7em] [&_li]:before:h-px [&_li]:before:w-2.5 [&_li]:before:bg-accent">
    <slot />
  </div>
</article>
