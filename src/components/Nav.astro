---
import withBase from "../lib/withBase";

const { active } = Astro.props;

const links = [
  { id: "projects", label: "Work", href: withBase("/projects") },
  { id: "cv", label: "CV", href: withBase("/cv") },
  { id: "blog", label: "Writing", href: withBase("/blog") },
];
---

<header class="sticky top-0 z-50 no-print">
  <div class="absolute inset-0 backdrop-blur-md" style="background: color-mix(in srgb, var(--paper) 82%, transparent)"></div>
  <nav class="wrap relative flex h-16 md:h-20 items-center justify-between gap-4" aria-label="Main">
    <a href={withBase("/")} class="group flex items-center gap-3" aria-label="Imam Hossain Roni, home">
      <span
        class="grid h-9 w-9 place-items-center rounded-full bg-ink text-paper font-serif text-lg italic transition-colors duration-300 group-hover:bg-accent"
        >ir</span
      >
      <span class="hidden sm:block text-[0.95rem] font-medium tracking-tight">Imam Hossain Roni</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <ul class="hidden md:flex items-center gap-7 mr-5 text-[0.95rem]">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="ulink py-1" aria-current={active === l.id ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <button
        type="button"
        data-theme-toggle
        class="grid h-10 w-10 place-items-center rounded-full border border-line transition-colors hover:border-ink"
        aria-label="Toggle dark mode"
      >
        <svg class="h-[1.05rem] w-[1.05rem] dark-hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z" stroke-linejoin="round"></path>
        </svg>
        <svg class="h-[1.1rem] w-[1.1rem] light-hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"></path>
        </svg>
      </button>

      <a href="mailto:imamhossainroni.de@gmail.com" class="hidden md:inline-flex btn-ink !py-2.5 !px-5 !text-sm">
        Get in touch
      </a>

      <button
        type="button"
        data-menu-toggle
        class="md:hidden grid h-10 w-10 place-items-center rounded-full border border-line"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M3 8h18M3 16h18" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="md:hidden fixed inset-x-0 top-16 bottom-0 bg-paper opacity-0 pointer-events-none transition-opacity duration-300 [&.open]:opacity-100 [&.open]:pointer-events-auto"
  >
    <ul class="wrap pt-10 grid gap-2">
      {
        [{ id: "home", label: "Home", href: withBase("/") }, ...links].map((l, i) => (
          <li class="border-b border-line">
            <a href={l.href} class="flex items-baseline justify-between py-4 display text-5xl" aria-current={active === l.id ? "page" : undefined}>
              {l.label}
              <span class="eyebrow">0{i + 1}</span>
            </a>
          </li>
        ))
      }
      <li class="pt-8">
        <a href="mailto:imamhossainroni.de@gmail.com" class="btn-ink">imamhossainroni.de@gmail.com</a>
      </li>
    </ul>
  </div>
</header>

<style>
  :global([data-theme="dark"]) .dark-hide,
  :global([data-theme="light"]) .light-hide {
    display: none;
  }
</style>

<script>
  function setup() {
    document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
    });

    const menuBtn = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const menu = document.getElementById("mobile-menu");
    menuBtn?.addEventListener("click", () => {
      const open = menu?.classList.toggle("open") ?? false;
      menuBtn.setAttribute("aria-expanded", String(open));
      document.body.style.overflow = open ? "hidden" : "";
    });
  }

  document.addEventListener("astro:page-load", setup);
  // View transitions swap the body, so make sure a stale scroll lock never survives navigation.
  document.addEventListener("astro:after-swap", () => (document.body.style.overflow = ""));
</script>
