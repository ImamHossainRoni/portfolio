---
import withBase from "../lib/withBase";

const year = new Date().getFullYear();
const email = "imamhossainroni.de@gmail.com";

const socials = [
  { label: "GitHub", href: "https://github.com/ImamHossainRoni" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/imamhossainroni" },
  { label: "Stack Overflow", href: "https://stackoverflow.com/users/6342245/imam-hossain-roni" },
  { label: "Hashnode", href: "https://imamhossainroni.hashnode.dev/" },
];
---

<footer id="contact" class="mt-28 md:mt-40 no-print">
  <div class="wrap">
    <div class="rule pt-14 md:pt-20">
      <p class="eyebrow mb-6" data-reveal>Contact</p>
      <h2 class="display text-[clamp(3rem,9vw,8.5rem)]" data-reveal style="--d:1">
        Have a hard problem?<br /><em>Let's talk.</em>
      </h2>

      <div class="mt-12 md:mt-16 grid gap-10 md:grid-cols-[1.4fr_1fr] md:items-end" data-reveal style="--d:2">
        <a
          href={`mailto:${email}`}
          class="group inline-flex items-center gap-4 text-[clamp(1.15rem,3vw,2.1rem)] font-light tracking-tight break-all"
        >
          <span class="ulink">{email}</span>
          <span
            class="grid h-11 w-11 md:h-14 md:w-14 shrink-0 place-items-center rounded-full bg-accent text-[--accent-ink] transition-transform duration-500 group-hover:rotate-45"
            aria-hidden="true"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M7 17 17 7M8 7h9v9" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        </a>

        <ul class="grid grid-cols-2 gap-x-6 gap-y-3 md:justify-self-end">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener" class="group inline-flex items-center gap-1.5 text-[0.95rem]">
                  <span class="ulink">{s.label}</span>
                  <span class="text-muted transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-20 mb-8 flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between eyebrow">
      <span>© {year} Imam Hossain Roni</span>
      <span>Frankfurt am Main, Germany</span>
      <a href={withBase("/")} class="ulink w-fit">Back to start ↑</a>
    </div>
  </div>
</footer>
